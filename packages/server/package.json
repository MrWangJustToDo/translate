{
  "name": "@my-agent/server",
  "version": "0.0.1",
  "description": "CoreEnv-compatible HTTP server backed by @my-agent/node, with type-safe RPC client",
  "keywords": [
    "ai",
    "agent",
    "server",
    "coreenv",
    "hono"
  ],
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/MyAgent.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/MyAgent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/MyAgent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./agent-session": {
      "types": "./dist/remote-session-client.d.mts",
      "import": "./dist/remote-session-client.mjs"
    }
  },
  "bin": {
    "my-agent-server": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "start": "node dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "validate:agent-session-channels": "pnpm run build && node scripts/validate-agent-session-channels.mjs",
    "validate:agent-session-http": "pnpm run build && node scripts/validate-agent-session-http.mjs",
    "validate:coreenv-http": "pnpm run build && node scripts/validate-coreenv-http.mjs",
    "validate:env-workspace": "pnpm run build && node scripts/validate-env-workspace.mjs",
    "validate:messages-delta": "pnpm run build && node scripts/validate-messages-delta.mjs",
    "validate:provider-proxy": "pnpm run build && node scripts/validate-provider-proxy.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@my-agent/core": "workspace:*",
    "@my-agent/node": "workspace:*",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.3"
  }
}
