{
  "name": "@my-agent/app",
  "version": "0.0.1",
  "description": "Shared app components and hooks for My Agent (CLI + Web)",
  "keywords": [
    "ai",
    "agent",
    "react",
    "terminal-ui",
    "tui"
  ],
  "license": "MIT",
  "author": {
    "name": "MrWangJustToDo",
    "url": "https://github.com/MrWangJustToDo"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrWangJustToDo/MyAgent.git",
    "directory": "packages/app"
  },
  "bugs": {
    "url": "https://github.com/MrWangJustToDo/MyAgent/issues"
  },
  "homepage": "https://github.com/MrWangJustToDo/MyAgent#readme",
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "dev": "tsdown --watch",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate:theme-palettes": "node ./scripts/validate-theme-palettes.mjs",
    "validate:core-imports": "node ./scripts/validate-core-imports.mjs",
    "validate:presentation-helpers": "node ./scripts/validate-presentation-helpers.mjs",
    "validate:session-only-smoke": "pnpm run build && pnpm --filter @my-agent/core build && pnpm --filter @my-agent/node build && node ./scripts/validate-session-only-smoke.mjs"
  },
  "dependencies": {
    "@git-diff-view/cli": "^0.1.10",
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/file": "^0.1.7",
    "@git-diff-view/lowlight": "^0.1.7",
    "@m234/nerd-fonts": "^0.5.1",
    "@my-react/react": "^0.3.30",
    "@my-react/react-terminal": "^0.0.31",
    "@tanstack/ai": "^0.53.0",
    "ansi-escapes": "^7.3.0",
    "chalk": "^5.6.2",
    "diff": "^9.0.0",
    "ink-gradient": "^4.0.0",
    "ink-link": "^5.0.0",
    "ink-select-input": "^6.2.0",
    "ink-stream-markdown": "^0.0.10",
    "ink-tab": "^5.2.0",
    "lodash-es": "^4.17.23",
    "reactivity-store": "^0.4.0"
  },
  "peerDependencies": {
    "@my-agent/core": "workspace:*"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.14",
    "ink": "npm:@my-react/react-terminal@0.0.31",
    "react": "npm:@my-react/react@0.3.30",
    "socket.io-client": "^4.8.3",
    "tsdown": "^0.21.10",
    "typescript": "^5.6.3"
  }
}
